{
  "name": "miku-connect",
  "version": "1.0.0",
  "description": "Miku Connect - notification and clipboard sync between your devices over WLAN",
  "main": "main.js",
  "author": "Miku",
  "license": "(MIT OR GPL-3.0-or-later)",
  "scripts": {
    "start": "electron .",
    "test": "node test/transfer.test.js",
    "dist:linux": "npx --yes electron-builder@^26.15.0 --linux AppImage",
    "dist:win": "npx --yes electron-builder@^26.15.0 --win nsis portable"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.2.1"
  },
  "build": {
    "appId": "com.mitsuha.miku.connect",
    "productName": "Miku Connect",
    "files": [
      "main.js",
      "preload.js",
      "transfer.js",
      "remote.js",
      "battery.js",
      "autostart.js",
      "deviceinfo.js",
      "latency.js",
      "notifwatch.js",
      "renderer/**",
      "build/icon.png",
      "licenses/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "Miku-Connect-Mitsuha_Miku_v1.${ext}",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Miku-Connect-Setup-Mitsuha_Miku_v1.${ext}"
    },
    "portable": {
      "artifactName": "Miku-Connect-Portable-Mitsuha_Miku_v1.${ext}"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron": true
  },
  "desktopName": "miku-connect.desktop"
}
